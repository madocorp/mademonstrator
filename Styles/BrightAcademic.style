/*
BrightAcademic is the printed-handout counterpart: warm paper, serif text,
centered headings, and subtle horizontal rules instead of heavy panels.
*/
Slide { backgroundColor: #efe3c9; padding: 7% 9% 6% 9%; }
Body { color: #202020; fontFamily: TeX Gyre Pagella, Noto Serif Display, Noto Serif, serif; fontSize: 3.25vh; lineGap: 0.9vh; }
List { gap: 0.8vh; }
ListItem { textAlign: left; }
ListMarker { color: #856018; fontWeight: bold; textAlign: left; width: 3.8vh; margin: 0 0.7vw 0 0; }
Image { height: 18vh; }
MainTitle { color: #775400; fontFamily: Noto Serif Display, TeX Gyre Pagella, serif; fontSize: 6.4vh; fontWeight: bold; textAlign: center; borderColor: #d2c6ab; borderWidth: 1px 0; padding: 0.9vh 0; }
SlideTitle { color: #775400; fontFamily: Noto Serif Display, TeX Gyre Pagella, serif; fontSize: 4.6vh; fontWeight: bold; textAlign: center; borderColor: #d2c6ab; borderWidth: 0 0 1px 0; padding: 0 0 0.6vh 0; margin: 0 2.4vw 1.25vh; }
Block { backgroundColor: #f7eedb; borderColor: #c9b78f; borderWidth: 1px 0; margin: 1.3vh 0.65vw; padding: 1.65vh 2vw; fontSize: 2.85vh; }
Quote { color: #856018; backgroundColor: transparent; borderColor: #856018; borderWidth: 1px 0; margin: 1.2vh 1.7vw; padding: 1.7vh 1.4vw; fontSize: 3.15vh; }
Code { color: #005f88; backgroundColor: #e4d7bd; borderColor: #c9b78f; borderWidth: 1px; margin: 0.7vh 0.8vw; padding: 1vh 1vw; fontFamily: monospace; fontSize: 2.25vh; }
Strong { color: #9d2727; fontWeight: bold; }
InlineCode { color: #005f88; backgroundColor: #f7eedb; fontFamily: monospace; fontSize: 2.5vh; }
Link { color: #0059b2; }
BlockTitle { color: #856018; fontSize: 3.4vh; fontWeight: bold; }
Subtitle { color: #775400; fontSize: 2.7vh; fontWeight: bold; }
