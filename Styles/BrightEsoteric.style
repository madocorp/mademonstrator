/*
BrightEsoteric keeps the ceremonial layout but makes it airy and readable:
centered text, oversized script-like titles, side accents, and pale lavender
panels.
*/
Slide { backgroundColor: #eee0f7; }
Body { color: #261d2d; fontFamily: TeX Gyre Pagella, Noto Serif Display, serif; fontSize: 3vh; lineGap: 0.7vh; textAlign: center; }
MainTitle { color: #6d368f; backgroundColor: transparent; fontFamily: TeX Gyre Chorus, Noto Serif Display, serif; fontSize: 9.2vh; fontWeight: bold; textAlign: center; borderWidth: 0; padding: 0; }
SlideTitle { color: #6d368f; backgroundColor: transparent; fontFamily: TeX Gyre Chorus, Noto Serif Display, serif; fontSize: 6.1vh; fontWeight: bold; textAlign: center; borderWidth: 0; padding: 0; }
Block { backgroundColor: #f7eefc; borderColor: #147a6c; borderWidth: 0 4px 0 0; padding: 1.2vh 1.9vw; fontSize: 2.7vh; textAlign: center; }
Quote { color: #147a6c; backgroundColor: #f6eafb; borderColor: #6d368f; borderWidth: 1px 5px; padding: 1.8vh; fontSize: 3vh; textAlign: center; }
Code { color: #006a8e; backgroundColor: #e3d2ef; borderColor: #c9b0d8; borderWidth: 1px; padding: 1.3vh; fontFamily: monospace; fontSize: 2.35vh; textAlign: left; }
Strong { color: #a12850; fontWeight: bold; }
InlineCode { color: #006a8e; backgroundColor: #f7eefc; fontFamily: monospace; fontSize: 2.5vh; }
Link { color: #295fb0; }
BlockTitle { color: #147a6c; fontSize: 3.4vh; fontWeight: bold; }
Subtitle { color: #6d368f; fontSize: 2.7vh; fontWeight: bold; }
