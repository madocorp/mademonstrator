/*
BrightTechnical keeps the technical, left-anchored grid feeling but on a clean
light surface. It uses blue dividers and compact type for engineering reviews
or architecture walkthroughs.
*/
Slide { backgroundColor: #dff3fb; padding: 3% 4% 4% 4%; }
Body { color: #10242d; fontFamily: Noto Sans Mono, TeX Gyre Cursor, monospace; fontSize: 2.7vh; lineGap: 0.3vh; }
List { gap: 0.2vh; }
ListItem { textAlign: left; }
ListMarker { color: #006f93; fontWeight: bold; textAlign: left; width: 3.5vh; margin: 0 0.45vw 0 0; }
Image { height: 14vh; }
MainTitle { color: #006b5f; fontFamily: Noto Sans Display, Noto Sans Mono, monospace; fontSize: 6.5vh; fontWeight: bold; textAlign: left; borderColor: #006f93; borderWidth: 0 0 0 8px; padding: 0.35vh 0 0.35vh 1.2vw; }
SlideTitle { color: #006b5f; backgroundColor: #c8e8f3; fontFamily: Noto Sans Display, Noto Sans Mono, monospace; fontSize: 3.9vh; fontWeight: bold; textAlign: left; borderColor: #006f93; borderWidth: 0 0 0 6px; padding: 0.3vh 0.9vw; margin: 0 0 0.35vh; }
Block { backgroundColor: #cfeaf3; borderColor: #68aabd; borderWidth: 1px 1px 1px 5px; margin: 0.3vh 0.2vw; padding: 0.55vh 0.7vw; fontSize: 2.35vh; }
Quote { color: #006f93; backgroundColor: #d3eef6; borderColor: #006f93; borderWidth: 1px 1px 1px 5px; margin: 0.35vh 0.3vw; padding: 0.7vh 0.7vw; fontFamily: monospace; fontSize: 2.55vh; }
Code { color: #004f6b; backgroundColor: #c7e0e9; borderColor: #006f93; borderWidth: 1px 1px 1px 6px; margin: 0.3vh 0.3vw; padding: 0.7vh 0.75vw; fontFamily: Noto Sans Mono, TeX Gyre Cursor, monospace; fontSize: 2.2vh; }
Strong { color: #a12f2f; fontWeight: bold; }
InlineCode { color: #004f6b; backgroundColor: #e2f1f6; fontFamily: monospace; fontSize: 2.5vh; }
Link { color: #005fb8; }
BlockTitle { color: #006f93; fontSize: 3.4vh; fontWeight: bold; }
Subtitle { color: #006b5f; fontSize: 2.7vh; fontWeight: bold; }
