/*
DarkAcademic is formal and bookish: serif body text, centered titles, generous
leading, and quiet rules. It should feel like a lecture hall or printed paper
adapted for projection.
*/
Slide { backgroundColor: #282016; }
Body { color: #eeeeee; fontFamily: TeX Gyre Pagella, Noto Serif Display, Noto Serif, serif; fontSize: 3.05vh; lineGap: 0.75vh; }
MainTitle { color: #f5d36b; fontFamily: Noto Serif Display, TeX Gyre Pagella, serif; fontSize: 6.6vh; fontWeight: bold; textAlign: center; borderColor: #3a3328; borderWidth: 1px 0; padding: 0.7vh 0; }
SlideTitle { color: #f5d36b; fontFamily: Noto Serif Display, TeX Gyre Pagella, serif; fontSize: 4.5vh; fontWeight: bold; textAlign: center; borderColor: #3a3328; borderWidth: 0 0 1px 0; padding: 0 0 0.45vh 0; }
Block { backgroundColor: #382b20; borderColor: #4a3d2c; borderWidth: 1px 0; padding: 1.5vh 1.8vw; fontSize: 2.75vh; }
Quote { color: #c9a86a; backgroundColor: transparent; borderColor: #c9a86a; borderWidth: 1px 0; padding: 1.6vh 1vw; fontSize: 3vh; }
Code { color: #9fd6ff; backgroundColor: #111820; borderColor: #3a3328; borderWidth: 1px; padding: 1.2vh; fontFamily: monospace; fontSize: 2.35vh; }
Strong { color: #f19999; fontWeight: bold; }
InlineCode { color: #9fd6ff; backgroundColor: #382b20; fontFamily: monospace; fontSize: 2.5vh; }
Link { color: #80bfff; }
BlockTitle { color: #c9a86a; fontSize: 3.4vh; fontWeight: bold; }
Subtitle { color: #f5d36b; fontSize: 2.7vh; fontWeight: bold; }
