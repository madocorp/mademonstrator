/*
DarkMinimal removes almost everything except hierarchy. It uses sparse
underlines, transparent boxes, and left-aligned titles for a calm editorial
deck with little ornament.
*/
Slide { backgroundColor: #161616; padding: 4% 6% 8% 10%; }
Body { color: #eeeeee; fontFamily: Noto Sans Display, TeX Gyre Heros, sans-serif; fontSize: 2.85vh; lineGap: 0.7vh; }
List { gap: 0.45vh; }
ListItem { textAlign: left; }
ListMarker { color: #cfcfcf; textAlign: left; width: 3.4vh; margin: 0 0.45vw 0 0; }
Image { height: 15vh; }
MainTitle { color: #ffffff; fontFamily: Noto Sans Display, TeX Gyre Heros, sans-serif; fontSize: 8.1vh; fontWeight: bold; textAlign: left; borderColor: #303030; borderWidth: 0 0 2px 0; padding: 0 0 0.6vh 0; }
SlideTitle { color: #ffffff; fontFamily: Noto Sans Display, TeX Gyre Heros, sans-serif; fontSize: 4.1vh; fontWeight: bold; textAlign: left; borderColor: #303030; borderWidth: 0 0 2px 0; padding: 0 0 0.5vh 0; margin: 0 0 0.9vh; }
Block { backgroundColor: transparent; borderColor: #303030; borderWidth: 0 0 1px 0; margin: 0.7vh 0; padding: 0.35vh 0.1vw; fontSize: 2.6vh; }
Quote { color: #cfcfcf; backgroundColor: transparent; borderColor: #cfcfcf; borderWidth: 0 0 0 2px; margin: 0.9vh 0; padding: 0.5vh 1.1vw; fontSize: 2.8vh; }
Code { color: #d8d8d8; backgroundColor: #202020; borderColor: #3a3a3a; borderWidth: 1px; margin: 0.6vh 0; padding: 0.65vh 0.7vw; fontFamily: monospace; fontSize: 2.2vh; }
Strong { color: #ffffff; fontWeight: bold; }
InlineCode { color: #d8d8d8; backgroundColor: #141414; fontFamily: monospace; fontSize: 2.5vh; }
Link { color: #a9c7ff; }
BlockTitle { color: #cfcfcf; fontSize: 3.4vh; fontWeight: bold; }
Subtitle { color: #ffffff; fontSize: 2.7vh; fontWeight: bold; }
