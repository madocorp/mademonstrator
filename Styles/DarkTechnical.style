/*
DarkTechnical is for systems, code, and operations talks. It is dense,
left-biased, terminal-like, and uses strong structural borders so slides feel
like instrument panels rather than posters.
*/
Slide { backgroundColor: #102c40; padding: 3% 4% 4% 4%; }
Body { color: #d8f7ff; fontFamily: Noto Sans Mono, TeX Gyre Cursor, monospace; fontSize: 2.65vh; lineGap: 0.25vh; }
List { gap: 0.2vh; }
ListItem { textAlign: left; }
ListMarker { color: #00d1ff; fontWeight: bold; textAlign: left; width: 3.5vh; margin: 0 0.45vw 0 0; }
Image { height: 14vh; }
MainTitle { color: #64ffda; fontFamily: Noto Sans Display, Noto Sans Mono, monospace; fontSize: 6.6vh; fontWeight: bold; textAlign: left; borderColor: #00d1ff; borderWidth: 0 0 0 8px; padding: 0.3vh 0 0.3vh 1.1vw; }
SlideTitle { color: #64ffda; backgroundColor: #1b4055; fontFamily: Noto Sans Display, Noto Sans Mono, monospace; fontSize: 3.9vh; fontWeight: bold; textAlign: left; borderColor: #00d1ff; borderWidth: 0 0 0 6px; padding: 0.25vh 0.8vw; margin: 0 0 0.35vh; }
Block { backgroundColor: #1b4055; borderColor: #1d6c8c; borderWidth: 1px 1px 1px 5px; margin: 0.3vh 0.2vw; padding: 0.5vh 0.65vw; fontSize: 2.3vh; }
Quote { color: #00d1ff; backgroundColor: #204b62; borderColor: #00d1ff; borderWidth: 1px 1px 1px 5px; margin: 0.35vh 0.3vw; padding: 0.65vh 0.65vw; fontFamily: monospace; fontSize: 2.5vh; }
Code { color: #b7f7ff; backgroundColor: #03111d; borderColor: #00d1ff; borderWidth: 1px 1px 1px 6px; margin: 0.3vh 0.3vw; padding: 0.65vh 0.7vw; fontFamily: Noto Sans Mono, TeX Gyre Cursor, monospace; fontSize: 2.2vh; }
Strong { color: #ff7b72; fontWeight: bold; }
InlineCode { color: #b7f7ff; backgroundColor: #081217; fontFamily: monospace; fontSize: 2.5vh; }
Link { color: #58a6ff; }
BlockTitle { color: #00d1ff; fontSize: 3.4vh; fontWeight: bold; }
Subtitle { color: #64ffda; fontSize: 2.7vh; fontWeight: bold; }
